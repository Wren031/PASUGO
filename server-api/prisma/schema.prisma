generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  passenger
  driver
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  Male
  Female
  Other
  PreferNotToSay
}

enum AccountStatus {
  Active
  Suspended
  Pending
  Inactive
}

enum OtpPurpose {
  verify_email
  reset_password
}

enum DriverVerificationDocumentType {
  DRIVER_LICENSE_FRONT
  DRIVER_LICENSE_BACK
  OR
  CR
  NBI_CLEARANCE
  POLICE_CLEARANCE
}

enum DriverVerificationStatus {
  Pending
  Approved
  Rejected
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role          @default(passenger)
  status       AccountStatus @default(Pending)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  passengerProfile PassengerProfile?
  driverProfile    DriverProfile?

  @@map("users")
}

model PassengerProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  // Personal Information
  firstName    String?   @map("first_name")
  middleName   String?   @map("middle_name")
  lastName     String?   @map("last_name")
  profilePhoto String?   @map("profile_photo")
  dateOfBirth  DateTime? @map("date_of_birth")
  gender       Gender?

  // Contact Information
  phone         String? @unique
  phoneVerified Boolean @default(false) @map("phone_verified")
  isVerified    Boolean @default(false) @map("is_verified")

  // Address
  address  String?
  city     String?
  province String?

  // Emergency Contact
  emergencyName     String? @map("emergency_name")
  emergencyPhone    String? @map("emergency_phone")
  emergencyRelation String? @map("emergency_relation")

  // Passenger Statistics
  totalRides     Int      @default(0) @map("total_rides")
  cancelledRides Int      @default(0) @map("cancelled_rides")
  averageRating  Decimal? @map("average_rating") @db.Decimal(3, 2)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passenger_profiles")
}

model DriverProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  // Personal Information
  firstName    String?   @map("first_name")
  middleName   String?   @map("middle_name")
  lastName     String?   @map("last_name")
  profilePhoto String?   @map("profile_photo")
  dateOfBirth  DateTime? @map("date_of_birth")
  gender       Gender?

  // Contact Information
  phone         String? @unique
  phoneVerified Boolean @default(false) @map("phone_verified")

  // Address
  address  String?
  city     String?
  province String?

  // Driver Information
  licenseNumber String?   @unique @map("license_number")
  licenseExpiry DateTime? @map("license_expiry")

  emergencyName     String? @map("emergency_name")
  emergencyPhone    String? @map("emergency_phone")
  emergencyRelation String? @map("emergency_relation")

  // Availability
  isOnline    Boolean @default(false) @map("is_online")
  isAvailable Boolean @default(false) @map("is_available")

  // Statistics
  totalRides     Int      @default(0) @map("total_rides")
  cancelledRides Int      @default(0) @map("cancelled_rides")
  completedRides Int      @default(0) @map("completed_rides")
  averageRating  Decimal? @map("average_rating") @db.Decimal(3, 2)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications DriverVerification[]

  @@map("driver_profiles")
}

model DriverVerification {
  id              String                         @id @default(cuid())
  driverProfileId String                         @map("driver_profile_id")
  documentType    DriverVerificationDocumentType @map("document_type")
  filePath        String                         @map("file_path")
  status          DriverVerificationStatus       @default(Pending)
  rejectionReason String?                        @map("rejection_reason")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@unique([driverProfileId, documentType])
  @@index([driverProfileId])
  @@map("driver_verifications")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String     @id @default(cuid())
  email     String
  purpose   OtpPurpose
  codeHash  String     @map("code_hash")
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("otp_codes")
}

model DriverRegistrationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  isUsed    Boolean   @default(false) @map("is_used")
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("driver_registration_codes")
}

model GroceryBranch {
  id        String       @id @default(uuid())
  name      String
  address   String

  latitude  Decimal      @db.Decimal(10, 7)
  longitude Decimal      @db.Decimal(10, 7)

  phone     String?

  isOpen    Boolean      @default(false)
  status    BranchStatus @default(ACTIVE)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  inventory BranchInventory[]

  @@map("grocery_branches")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory BranchInventory[]

  @@map("products")
}

model BranchInventory {
  id                String   @id @default(uuid())

  branchId          String
  productId         String

  sku               String?
  barcode           String?

  price             Decimal  @db.Decimal(10, 2)
  costPrice         Decimal? @db.Decimal(10, 2)

  stockQuantity     Decimal  @default(0) @db.Decimal(10, 2)
  reservedQuantity  Decimal  @default(0) @db.Decimal(10, 2)

  lowStockThreshold Decimal? @default(5) @db.Decimal(10, 2)

  isAvailable       Boolean  @default(true)
  isFeatured        Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch  GroceryBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])

  @@map("branch_inventory")
}
